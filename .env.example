# SrRobs Skin Trader Pro — configuração
# Copia para .env e preenche. NUNCA faças commit do .env.

# Geral
# Nota: USD é recomendado — CSFloat e DMarket só devolvem USD e o motor ignora
# leituras noutra moeda. Steam e Skinport suportam EUR/USD.
CURRENCY=USD
DATABASE_PATH=data/trader.db
LOG_LEVEL=INFO
# true para arrancar o scheduler junto com o Flask
RUN_SCHEDULER=true

# Motor
# EV líquido tem de superar este múltiplo do desvio-padrão para ser "robusto"
RISK_MULTIPLIER=2.0
# Janela em dias do desvio-padrão usado pelo motor de risco
RISK_WINDOW_DAYS=30
# Idade máxima (horas) de um preço para ser considerado fresco
PRICE_FRESHNESS_HOURS=24
# Taxa de venda na Steam (~15%); usada para calcular o valor líquido
STEAM_SALE_FEE=0.15
# Margem mínima de lucro (%) para sugerir venda no fim do lock
MIN_SELL_MARGIN_PCT=2.0

# Coletores — limites por execução
STEAM_MAX_PER_RUN=20
CSFLOAT_MAX_PER_RUN=25

# Steam Community Market (pricehistory precisa de cookies de sessão)
# Obtém o cookie SteamLoginSecure do browser com sessão iniciada.
STEAM_COOKIES=

# CSFloat (chave GRATUITA: csfloat.com -> perfil -> separador "developer")
CSFLOAT_API_KEY=

# Skinport (API pública; chave só é precisa para endpoints privados)
SKINPORT_API_KEY=

# DMarket (https://dmarket.com — definições -> API keys: par público/secreta)
DMARKET_PUBLIC_KEY=
DMARKET_SECRET_KEY=

# Notificações Telegram (reutiliza o bot Roco)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Threshold de EV líquido (na moeda configurada) para alerta de oportunidade
NOTIFY_MIN_EV=10.0

# Camada de IA local (LM Studio, server OpenAI-compatible)
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
